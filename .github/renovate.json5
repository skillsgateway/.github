// Shared Renovate preset for @skillsgateway, and this repository's own config.
//
// Extend it from a repository with a single line:
//
//   { extends: ["github>skillsgateway/.github//.github/renovate.json5"] }
//
// Repository-specific rules — dependency groupings, ecosystem pins — go in that
// file alongside the extends, not here.
//
// LABELS REFERENCED BELOW MUST EXIST ON THE CONSUMING REPOSITORY. Renovate does
// not create labels, and silently drops any that do not exist, so a label that
// was never created means the rule referencing it does nothing at all. Required:
//
//   bot-renovate, bot-renovate-stop, bot-renovate-rebase, security,
//   renovate-version-major, renovate-version-minor,
//   renovate-version-patch, renovate-version-pin, renovate-version-digest
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:recommended",
    ":semanticCommits",
  ],

  // Dependency PRs land as `chore(<datasource>): ...`, which keeps them valid
  // Conventional Commits — the PR title becomes the commit subject on main.
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  semanticCommitScope: "{{datasource}}",

  branchPrefix: "renovate/",

  // Backstop: converts a range back to an exact pin if one ever creeps in.
  rangeStrategy: "pin",

  addLabels: ["bot-renovate"],

  // Functional rather than decorative — add this label to a PR to stop Renovate
  // updating or rebasing it any further.
  stopUpdatingLabel: "bot-renovate-stop",
  // The inverse. Renamed only to match the label above; the default is "rebase".
  rebaseLabel: "bot-renovate-rebase",

  dependencyDashboard: false,

  prConcurrentLimit: 10,
  prHourlyLimit: 5,

  separateMajorMinor: true,
  separateMultipleMajor: true,

  lockFileMaintenance: {
    enabled: true,
  },

  vulnerabilityAlerts: {
    enabled: true,
    addLabels: ["security"],
  },

  osvVulnerabilityAlerts: true,

  packageRules: [
    // =====================================================
    // Version classification labels.
    //
    // Every Renovate PR states its own risk tier at a glance, including one
    // sitting open because its checks failed.
    //
    // minimumReleaseAge is a supply-chain mitigation, not noise reduction: a
    // malicious or compromised version is usually caught and pulled within a
    // few days, so merging a same-day release means installing it before
    // anyone has had a chance to notice. It costs nothing for a legitimate
    // release.
    // =====================================================
    {
      matchUpdateTypes: ["major"],
      addLabels: ["renovate-version-major"],
      minimumReleaseAge: "7 days",
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["renovate-version-minor"],
      minimumReleaseAge: "3 days",
      automerge: true,
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["renovate-version-patch"],
      minimumReleaseAge: "3 days",
      automerge: true,
    },
    // A pin replaces a range with the version already resolved in the lock
    // file, so nothing new is installed and minimumReleaseAge has no release
    // to measure.
    {
      matchUpdateTypes: ["pin"],
      addLabels: ["renovate-version-pin"],
      automerge: true,
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["renovate-version-digest"],
    },

    // =====================================================
    // GitHub Actions.
    //
    // Commit metadata only; the tier rules above decide automerge. A bump to a
    // new release of a SHA-pinned action is a minor/patch and automerges. A
    // re-pointed tag with no new release is a digest update and stays manual:
    // that is the supply-chain case SHA pinning exists to catch, and
    // minimumReleaseAge has no release to measure there.
    // =====================================================
    {
      matchManagers: ["github-actions"],
      semanticCommitType: "chore",
      semanticCommitScope: "github-actions",
    },
  ],

  // =====================================================
  // Automerge: minor, patch and pin only.
  //
  // `platformAutomerge: true` hands the merge to GitHub's auto-merge, which
  // fires the moment the ruleset is satisfied. With `false` (#5) Renovate
  // merged on its own next run, and on the hosted app that left a green PR
  // open for hours. The switch is only safe because `protect-main` requires
  // EVERY check that runs on a PR (safe-settings/suborgs/*.yml): GitHub
  // auto-merge waits for required checks alone, and with none required a PR
  // merges before CI has run -- reqstool/.github#111 landed three failing
  // builds on a main that way. So a workflow added to a consuming repo must
  // become a required check in the same PR.
  //
  // The approving review the ruleset requires comes from the renovate-approve
  // App, which only ever approves PRs authored by Renovate. Renovate itself has
  // no ruleset bypass -- an exemption would skip the checks too, which is
  // exactly what must not happen for an unattended merge.
  //
  // Major stays manual: a major is a behaviour change worth a human reading the
  // changelog, and `minimumReleaseAge: 7 days` already says these are not
  // urgent. Digests stay manual because a re-pointed tag is the supply-chain
  // case SHA pinning exists to catch. minimumReleaseAge is applied before a
  // PR is opened (internalChecksFilter: strict, the default), so it does not
  // depend on `renovate/stability-days` being a required status -- and it must
  // not be one, as that status never appears on a human PR.
  // =====================================================
  automergeType: "pr",
  platformAutomerge: true,
}
